---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contribute Now" description="Support Friends Association for a Change — donate via ICICI Bank or SBI to help underprivileged communities.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-[#1a6b3c] mb-2">Contribute Now</h1>
    <div class="w-16 h-1 bg-[#e87722] mb-8"></div>

    <div class="grid md:grid-cols-2 gap-8 items-start">
      <div>
        <img src="/images/2016/05/money-1302832_1280.jpg" alt="Contribute to FA4C" class="rounded-xl shadow-md w-full object-cover" />
        <div class="mt-6 bg-[#f0faf4] rounded-xl p-5 border border-[#1a6b3c]/20">
          <h3 class="font-semibold text-[#1a6b3c] mb-2">Why Contribute?</h3>
          <ul class="text-sm text-gray-600 space-y-2">
            <li>✅ Help a student continue their education</li>
            <li>✅ Fund a plantation drive in Visakhapatnam</li>
            <li>✅ Support a blood donation camp</li>
            <li>✅ Empower a woman towards employment</li>
            <li>✅ Promote cultural activities for youth</li>
          </ul>
          <p class="text-xs text-gray-500 mt-4">FA4C publishes annual audit reports for full transparency. <a href="/audit-reports/" class="text-[#1a6b3c] underline">View Reports →</a></p>
        </div>
      </div>

      <div class="space-y-6">
        <!-- ICICI -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center text-orange-600 font-bold text-sm">ICICI</div>
            <h2 class="text-xl font-bold text-gray-800">ICICI Bank</h2>
          </div>
          <table class="w-full text-sm">
            <tbody class="divide-y divide-gray-100">
              <tr class="py-2"><td class="py-2 text-gray-500 w-44">Account Name</td><td class="py-2 font-medium">FRIENDS ASSOCIATION FOR A CHANGE</td></tr>
              <tr><td class="py-2 text-gray-500">Account Number</td><td class="py-2 font-medium font-mono">006001033376</td></tr>
              <tr><td class="py-2 text-gray-500">IFSC Code</td><td class="py-2 font-medium font-mono">ICIC0000060</td></tr>
              <tr><td class="py-2 text-gray-500">Branch</td><td class="py-2 font-medium">Visakhapatnam Main Branch</td></tr>
            </tbody>
          </table>
        </div>

        <!-- SBI -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center text-blue-700 font-bold text-sm">SBI</div>
            <h2 class="text-xl font-bold text-gray-800">State Bank of India</h2>
          </div>
          <table class="w-full text-sm">
            <tbody class="divide-y divide-gray-100">
              <tr class="py-2"><td class="py-2 text-gray-500 w-44">Account Name</td><td class="py-2 font-medium">FRIENDS ASSOCIATION FOR A CHANGE</td></tr>
              <tr><td class="py-2 text-gray-500">Account Number</td><td class="py-2 font-medium font-mono">33747868111</td></tr>
              <tr><td class="py-2 text-gray-500">IFSC Code</td><td class="py-2 font-medium font-mono">SBIN0006959</td></tr>
              <tr><td class="py-2 text-gray-500">Branch</td><td class="py-2 font-medium">Marripalem, Visakhapatnam</td></tr>
            </tbody>
          </table>
        </div>

        <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-sm text-yellow-800">
          <strong>After transferring:</strong> Please email <a href="mailto:fa4change@gmail.com" class="underline">fa4change@gmail.com</a> with your name, amount, and transaction reference so we can acknowledge your contribution.
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

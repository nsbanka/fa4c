---
import BaseLayout from '../layouts/BaseLayout.astro';

const modules = import.meta.glob('../data/gallery-cms/*.md', { eager: true });
const galleryYears = Object.values(modules)
  .map((mod: any) => ({
    year: mod.frontmatter.year,
    images: (mod.frontmatter.images ?? []).map((img: any) => ({
      src: img.image,
      width: 1200,
      height: 900,
      alt: img.alt,
    })),
    blogspotUrl: mod.frontmatter.blogspotUrl,
  }))
  .sort((a, b) => Number(b.year) - Number(a.year));
---

<BaseLayout title="Gallery" description="Photo gallery of FA4C activities from 2013 to 2017 — community events, programmes, and more.">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-[#1a6b3c] mb-2">Photo Gallery</h1>
    <div class="w-16 h-1 bg-[#e87722] mb-4"></div>
    <p class="text-gray-600 mb-8">Click any photo to view it full size.</p>

    <!-- Year navigation -->
    <div class="flex flex-wrap gap-2 mb-10">
      {galleryYears.map(y => (
        <a href={`#year-${y.year}`} class="px-4 py-2 bg-[#f0faf4] border border-[#1a6b3c]/20 text-[#1a6b3c] font-medium text-sm rounded-full hover:bg-[#1a6b3c] hover:text-white transition-colors">
          {y.year}
        </a>
      ))}
    </div>

    <!-- Gallery sections by year -->
    {galleryYears.map(yearData => (
      <section id={`year-${yearData.year}`} class="mb-14 scroll-mt-20">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-bold text-[#1a6b3c]">
            Albums of {yearData.year}
          </h2>
          {yearData.blogspotUrl && (
            <a
              href={yearData.blogspotUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-[#e87722] font-medium hover:underline flex items-center gap-1"
            >
              View Full Album
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          )}
        </div>

        <div
          class="pswp-gallery grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3"
          id={`gallery-${yearData.year}`}
        >
          {yearData.images.map(img => (
            <a
              href={img.src}
              data-pswp-width={img.width}
              data-pswp-height={img.height}
              target="_blank"
              class="overflow-hidden rounded-lg shadow hover:shadow-md transition-shadow"
            >
              <img
                src={img.src}
                alt={img.alt}
                class="w-full h-40 object-cover hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  document.querySelectorAll<HTMLElement>('.pswp-gallery').forEach(gallery => {
    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children: 'a',
      pswpModule: () => import('photoswipe'),
    });
    lightbox.init();
  });
</script>

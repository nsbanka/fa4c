---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Us" description="Get in touch with Friends Association for a Change — we'd love to hear from you.">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-[#1a6b3c] mb-2">Contact Us</h1>
    <div class="w-16 h-1 bg-[#e87722] mb-8"></div>

    <div class="grid md:grid-cols-2 gap-10">
      <!-- Contact form -->
      <div>
        <h2 class="text-xl font-bold text-gray-800 mb-6">Send us a message</h2>
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-4"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Full Name <span class="text-red-500">*</span></label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Your full name"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#1a6b3c] focus:border-transparent"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address <span class="text-red-500">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="your@email.com"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#1a6b3c] focus:border-transparent"
            />
          </div>

          <div>
            <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="How can we help?"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#1a6b3c] focus:border-transparent"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message <span class="text-red-500">*</span></label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="Your message..."
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#1a6b3c] focus:border-transparent resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-[#1a6b3c] text-white font-semibold py-3 px-6 rounded-lg hover:bg-[#134f2d] transition-colors"
          >
            Send Message
          </button>
        </form>
      </div>

      <!-- Contact info -->
      <div class="space-y-6">
        <div>
          <h2 class="text-xl font-bold text-gray-800 mb-4">Our Details</h2>
          <address class="not-italic text-gray-700 leading-relaxed">
            <strong>Friends Association for a Change</strong><br />
            Door No. 58-14-91, Flat No. 401<br />
            Prakash Residency, HIG-20<br />
            Marripalem VUDA Layout<br />
            Visakhapatnam, AP 530009<br />
            India
          </address>
        </div>

        <div class="space-y-3">
          <a href="mailto:fa4change@gmail.com" class="flex items-center gap-3 text-gray-700 hover:text-[#1a6b3c] transition-colors">
            <div class="w-10 h-10 bg-[#f0faf4] rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-[#1a6b3c]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            fa4change@gmail.com
          </a>
          <a href="https://www.facebook.com/fa4change" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-gray-700 hover:text-[#1a6b3c] transition-colors">
            <div class="w-10 h-10 bg-[#f0faf4] rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-[#1a6b3c]" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3l-.5 3H13v6.95c4.56-.93 8-4.96 8-9.95z"/></svg>
            </div>
            facebook.com/fa4change
          </a>
          <a href="https://twitter.com/fa4change" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-gray-700 hover:text-[#1a6b3c] transition-colors">
            <div class="w-10 h-10 bg-[#f0faf4] rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-[#1a6b3c]" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </div>
            twitter.com/fa4change
          </a>
        </div>

        <div class="rounded-xl overflow-hidden shadow border border-gray-200">
          <iframe
            width="100%"
            height="250"
            loading="lazy"
            allowfullscreen
            title="FA4C Location"
            src="https://maps.google.com/maps?q=Marripalem+VUDA+Layout+Visakhapatnam+Andhra+Pradesh+530009&output=embed">
          </iframe>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

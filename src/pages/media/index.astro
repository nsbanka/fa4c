---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Media" description="FA4C in the news — online coverage and press mentions of Friends Association for a Change.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-[#1a6b3c] mb-2">Media Coverage</h1>
    <div class="w-16 h-1 bg-[#e87722] mb-8"></div>
    <p class="text-gray-600 mb-10 text-lg">
      Friends Association for a Change has been covered by various online publications and print media. Here is a selection of our media presence.
    </p>

    <div class="grid sm:grid-cols-2 gap-6">
      <a href="/media/online/" class="group bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
        <div class="text-3xl mb-3">🌐</div>
        <h2 class="text-xl font-bold text-[#1a6b3c] mb-2">Online Coverage</h2>
        <p class="text-gray-600 text-sm leading-relaxed">Coverage on websites, portals, and online publications featuring FA4C's programmes and events.</p>
        <div class="mt-4 text-[#e87722] text-sm font-semibold group-hover:underline">View Online Media →</div>
      </a>

      <a href="/media/press/" class="group bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
        <div class="text-3xl mb-3">📰</div>
        <h2 class="text-xl font-bold text-[#1a6b3c] mb-2">Press Coverage</h2>
        <p class="text-gray-600 text-sm leading-relaxed">Print media articles and clippings from newspapers covering FA4C's initiatives.</p>
        <div class="mt-4 text-[#e87722] text-sm font-semibold group-hover:underline">View Press Coverage →</div>
      </a>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';

const programmes = [
  {
    slug: 'vidyabhyasam',
    name: 'Vidyabhyasam',
    icon: '📚',
    color: 'bg-blue-50 border-blue-200',
    description: 'Supporting underprivileged students from 6th to 10th standard in government schools by providing financial aid for their education. We prefer orphans and semi-orphans studying in Municipal Corporation, Zilla Parishad, or Government Aided schools.',
    image: '/images/2016/05/Vidyabyasam.jpg',
  },
  {
    slug: 'pragathi',
    name: 'Pragathi',
    icon: '🌱',
    color: 'bg-green-50 border-green-200',
    description: 'Environmental development through plantation programmes at housing areas, schools, and colleges. All activities related to environmental awareness and development fall under Pragathi.',
    image: '/images/2016/05/FA4Change-Pragathi-Program.jpg',
  },
  {
    slug: 'sphoorthi',
    name: 'Sphoorthi',
    icon: '🩸',
    color: 'bg-red-50 border-red-200',
    description: 'Medical support and blood donation drives. A person who helps during a medical emergency stands as an inspiration to others. All medical-related programmes are part of Sphoorthi.',
    image: '/images/2016/05/Spoorthi.png',
  },
  {
    slug: 'sankalpam',
    name: 'Sankalpam',
    icon: '👩',
    color: 'bg-purple-50 border-purple-200',
    description: 'Empowering women in distress with determination (sankalpam) and guidance towards employment and self-sufficiency. All women empowerment programmes fall under Sankalpam.',
    image: '/images/2016/05/Sankalpam-page-001.jpg',
  },
  {
    slug: 'mee-nestham',
    name: 'Mee Nestham',
    icon: '🎭',
    color: 'bg-orange-50 border-orange-200',
    description: 'Promoting Indian culture, sports, arts, and skills of talented individuals. All activities beyond the four core programmes are part of Mee Nestham — truly "your friendship".',
    image: '/images/2016/05/Mee-nestam-JPG2-Copy.jpg',
  },
];
---

<BaseLayout title="Our Programmes" description="Learn about the five programmes run by Friends Association for a Change — education, environment, health, women empowerment, and culture.">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-[#1a6b3c] mb-2">Our Programmes</h1>
    <div class="w-16 h-1 bg-[#e87722] mb-4"></div>
    <p class="text-gray-600 text-lg mb-10 max-w-2xl">
      FA4C runs five focused programmes addressing education, environment, health, women empowerment, and cultural activities in the Visakhapatnam community.
    </p>

    <div class="space-y-10">
      {programmes.map((p, i) => (
        <div class={`flex flex-col ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} gap-8 items-center bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden`}>
          <div class="md:w-80 flex-shrink-0 h-56 overflow-hidden">
            <img src={p.image} alt={p.name} class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="flex-1 p-6 md:p-8">
            <div class="text-3xl mb-3">{p.icon}</div>
            <h2 class="text-2xl font-bold text-[#1a6b3c] mb-3">{p.name}</h2>
            <p class="text-gray-600 leading-relaxed mb-5">{p.description}</p>
            <a href={`/our-programmes/${p.slug}/`} class="inline-block bg-[#1a6b3c] text-white font-semibold px-6 py-2.5 rounded-full hover:bg-[#134f2d] transition-colors text-sm">
              Learn More →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';

const modules = import.meta.glob('../../data/programmes/*.md', { eager: true });
const programmes = (Object.values(modules) as any[])
  .map((mod: any) => mod.frontmatter)
  .sort((a: any, b: any) => (a.order ?? 99) - (b.order ?? 99));
---

<BaseLayout title="Our Programmes" description="Learn about the five programmes run by Friends Association for a Change — education, environment, health, women empowerment, and culture.">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-[#1a6b3c] mb-2">Our Programmes</h1>
    <div class="w-16 h-1 bg-[#e87722] mb-4"></div>
    <p class="text-gray-600 text-lg mb-10 max-w-2xl">
      FA4C runs five focused programmes addressing education, environment, health, women empowerment, and cultural activities in the Visakhapatnam community.
    </p>

    <div class="space-y-10">
      {programmes.map((p: any, i: number) => (
        <div class={`flex flex-col ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} gap-8 items-center bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden`}>
          <div class="md:w-80 flex-shrink-0 h-56 bg-gray-50 overflow-hidden flex items-center justify-center">
            {p.image ? (
              <img src={p.image} alt={p.name} class="w-full h-full object-cover" loading="lazy" />
            ) : (
              <span class="text-6xl">{p.icon}</span>
            )}
          </div>
          <div class="flex-1 p-6 md:p-8">
            <div class="text-3xl mb-3">{p.icon}</div>
            <h2 class="text-2xl font-bold text-[#1a6b3c] mb-3">{p.name}</h2>
            <p class="text-gray-600 leading-relaxed mb-5">{p.description}</p>
            <a href={`/our-programmes/${p.slug}/`} class="inline-block bg-[#1a6b3c] text-white font-semibold px-6 py-2.5 rounded-full hover:bg-[#134f2d] transition-colors text-sm">
              Learn More →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

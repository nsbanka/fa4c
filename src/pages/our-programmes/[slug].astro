---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../data/programmes/*.md', { eager: true });
  return Object.values(modules).map((mod: any) => ({
    params: { slug: mod.frontmatter.slug },
    props: { mod },
  }));
}

const { mod } = Astro.props;
const { name, icon, description, image } = mod.frontmatter;
const { compiledContent } = mod;
const html = compiledContent();
---
<BaseLayout title={name} description={description}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/our-programmes/" class="hover:text-[#1a6b3c]">Our Programmes</a> / <span class="text-gray-800">{name}</span>
    </nav>
    <h1 class="text-4xl font-bold text-[#1a6b3c] mb-2">{name} <span class="text-2xl">{icon}</span></h1>
    <div class="w-16 h-1 bg-[#e87722] mb-8"></div>

    {image && (
      <div class="rounded-xl shadow-md mb-8 overflow-hidden bg-gray-50 flex items-center justify-center max-h-72">
        <img src={image} alt={`${name} Programme`} class="max-h-72 w-auto max-w-full object-contain" />
      </div>
    )}

    <div class="prose prose-lg max-w-none text-gray-700 prose-headings:text-[#1a6b3c]" set:html={html} />

    <div class="mt-10 flex flex-wrap gap-4">
      <a href="/our-programmes/" class="border border-[#1a6b3c] text-[#1a6b3c] font-semibold px-6 py-2.5 rounded-full hover:bg-[#1a6b3c] hover:text-white transition-colors text-sm">← All Programmes</a>
      <a href="/contribute-now/" class="bg-[#e87722] text-white font-semibold px-6 py-2.5 rounded-full hover:bg-[#d06820] transition-colors text-sm">Support This Programme</a>
    </div>
  </div>
</BaseLayout>

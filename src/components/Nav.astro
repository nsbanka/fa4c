---
const pathname = Astro.url.pathname;
const isActive = (path: string) =>
  pathname === path || pathname.startsWith(path + '/') ? 'text-orange-400 font-semibold' : 'hover:text-orange-300';
---

<header class="bg-[#1a6b3c] text-white shadow-md sticky top-0 z-40">
  <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between" aria-label="Main navigation">
    <!-- Logo & site name -->
    <a href="/" class="flex items-center gap-3 flex-shrink-0">
      <img src="/images/logo.jpg" alt="FA4C Logo" class="h-12 w-12 rounded-full object-cover" />
      <div class="leading-tight">
        <div class="font-bold text-sm sm:text-base">Friends Association</div>
        <div class="text-orange-300 text-xs sm:text-sm font-medium">for a Change</div>
      </div>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden lg:flex items-center gap-6 text-sm font-medium">
      <li><a href="/" class={isActive('/')}>Home</a></li>
      <li><a href="/about-us/" class={isActive('/about-us')}>About Us</a></li>
      <li class="relative group">
        <a href="/our-programmes/" class={`${isActive('/our-programmes')} flex items-center gap-1`}>
          Programmes
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <ul class="absolute top-full left-0 mt-1 w-48 bg-white text-gray-800 rounded shadow-lg hidden group-hover:block group-focus-within:block">
          <li><a href="/our-programmes/vidyabhyasam/" class="block px-4 py-2 text-sm hover:bg-green-50 hover:text-green-800">Vidyabhyasam</a></li>
          <li><a href="/our-programmes/pragathi/" class="block px-4 py-2 text-sm hover:bg-green-50 hover:text-green-800">Pragathi</a></li>
          <li><a href="/our-programmes/sphoorthi/" class="block px-4 py-2 text-sm hover:bg-green-50 hover:text-green-800">Sphoorthi</a></li>
          <li><a href="/our-programmes/sankalpam/" class="block px-4 py-2 text-sm hover:bg-green-50 hover:text-green-800">Sankalpam</a></li>
          <li><a href="/our-programmes/mee-nestham/" class="block px-4 py-2 text-sm hover:bg-green-50 hover:text-green-800">Mee Nestham</a></li>
        </ul>
      </li>
      <li><a href="/gallery/" class={isActive('/gallery')}>Gallery</a></li>
      <li class="relative group">
        <a href="/media/" class={`${isActive('/media')} flex items-center gap-1`}>
          Media
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </a>
        <ul class="absolute top-full left-0 mt-1 w-40 bg-white text-gray-800 rounded shadow-lg hidden group-hover:block group-focus-within:block">
          <li><a href="/media/online/" class="block px-4 py-2 text-sm hover:bg-green-50 hover:text-green-800">Online</a></li>
          <li><a href="/media/press/" class="block px-4 py-2 text-sm hover:bg-green-50 hover:text-green-800">Press</a></li>
        </ul>
      </li>
      <li>
        <a href="/contribute-now/" class="bg-[#e87722] hover:bg-[#d06820] text-white px-4 py-2 rounded-full text-sm font-semibold transition-colors">
          Contribute Now
        </a>
      </li>
      <li><a href="/contact-us/" class={isActive('/contact-us')}>Contact</a></li>
    </ul>

    <!-- Mobile hamburger -->
    <details class="lg:hidden">
      <summary class="cursor-pointer list-none p-2 rounded hover:bg-green-700 transition-colors" aria-label="Open menu">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </summary>
      <div class="absolute top-full left-0 right-0 bg-[#1a6b3c] shadow-lg pb-4">
        <ul class="flex flex-col px-4 pt-2 gap-1 text-sm">
          <li><a href="/" class="block py-2 border-b border-green-700">Home</a></li>
          <li><a href="/about-us/" class="block py-2 border-b border-green-700">About Us</a></li>
          <li><a href="/our-programmes/" class="block py-2 border-b border-green-700 font-medium">Our Programmes</a></li>
          <li><a href="/our-programmes/vidyabhyasam/" class="block py-2 pl-4 border-b border-green-700 text-orange-200">Vidyabhyasam</a></li>
          <li><a href="/our-programmes/pragathi/" class="block py-2 pl-4 border-b border-green-700 text-orange-200">Pragathi</a></li>
          <li><a href="/our-programmes/sphoorthi/" class="block py-2 pl-4 border-b border-green-700 text-orange-200">Sphoorthi</a></li>
          <li><a href="/our-programmes/sankalpam/" class="block py-2 pl-4 border-b border-green-700 text-orange-200">Sankalpam</a></li>
          <li><a href="/our-programmes/mee-nestham/" class="block py-2 pl-4 border-b border-green-700 text-orange-200">Mee Nestham</a></li>
          <li><a href="/gallery/" class="block py-2 border-b border-green-700">Gallery</a></li>
          <li><a href="/media/" class="block py-2 border-b border-green-700">Media</a></li>
          <li><a href="/media/online/" class="block py-2 pl-4 border-b border-green-700 text-orange-200">Online</a></li>
          <li><a href="/media/press/" class="block py-2 pl-4 border-b border-green-700 text-orange-200">Press</a></li>
          <li><a href="/contribute-now/" class="block py-2 border-b border-green-700 text-orange-300 font-semibold">Contribute Now</a></li>
          <li><a href="/contact-us/" class="block py-2">Contact Us</a></li>
        </ul>
      </div>
    </details>
  </nav>
</header>

---
---

<footer class="bg-[#134f2d] text-white mt-16">
  <div class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-8">
    <!-- About -->
    <div>
      <div class="flex items-center gap-3 mb-4">
        <img src="/images/logo.jpg" alt="FA4C Logo" class="h-12 w-12 rounded-full object-cover" />
        <div>
          <div class="font-bold">Friends Association for a Change</div>
          <div class="text-orange-300 text-sm">fa4change.org</div>
        </div>
      </div>
      <p class="text-green-200 text-sm leading-relaxed">
        Working for the underprivileged community since 2011. Based in Visakhapatnam, Andhra Pradesh, India.
      </p>
    </div>

    <!-- Quick links -->
    <div>
      <h3 class="font-semibold text-orange-300 mb-4">Quick Links</h3>
      <ul class="space-y-2 text-sm text-green-200">
        <li><a href="/about-us/" class="hover:text-white transition-colors">About Us</a></li>
        <li><a href="/our-programmes/" class="hover:text-white transition-colors">Our Programmes</a></li>
        <li><a href="/gallery/" class="hover:text-white transition-colors">Gallery</a></li>
        <li><a href="/contribute-now/" class="hover:text-white transition-colors">Contribute Now</a></li>
        <li><a href="/audit-reports/" class="hover:text-white transition-colors">Audit Reports</a></li>
        <li><a href="/faqs/" class="hover:text-white transition-colors">FAQs</a></li>
        <li><a href="/contact-us/" class="hover:text-white transition-colors">Contact Us</a></li>
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h3 class="font-semibold text-orange-300 mb-4">Contact</h3>
      <address class="not-italic text-sm text-green-200 space-y-2">
        <p>Door No. 58-14-91, Flat No. 401<br />Prakash Residency, HIG-20<br />Marripalem VUDA Layout<br />Visakhapatnam, AP 530009</p>
        <p>
          <a href="mailto:fa4change@gmail.com" class="hover:text-white transition-colors flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            fa4change@gmail.com
          </a>
        </p>
      </address>

      <!-- Social -->
      <div class="flex gap-4 mt-4">
        <a href="https://www.facebook.com/fa4change" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-green-300 hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3l-.5 3H13v6.95c4.56-.93 8-4.96 8-9.95z"/></svg>
        </a>
        <a href="https://twitter.com/fa4change" target="_blank" rel="noopener noreferrer" aria-label="Twitter / X" class="text-green-300 hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-green-800 text-center py-4 text-green-400 text-xs">
    © Friends Association for a Change. All rights reserved.
  </div>
</footer>
